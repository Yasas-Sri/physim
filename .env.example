# Supabase (client-safe — publishable key only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Anthropic — SERVER ONLY. Never prefix with NEXT_PUBLIC_. Never import into a client component.
ANTHROPIC_API_KEY=

# Groq (speech-to-text) — SERVER ONLY. Never prefix with NEXT_PUBLIC_. Never reaches the client bundle.
GROQ_API_KEY=

# Optional: bypass the live mic and inject a canned transcript (demo safety net).
NEXT_PUBLIC_DEMO_MODE=

# Rate limiting uses a Supabase table + rate_limit_hit() (run supabase/migrations/rate-limit.sql).
# To use Upstash instead, add these and swap the backend in lib/ratelimit.ts:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
